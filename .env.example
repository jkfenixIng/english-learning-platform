# Supabase (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_learning?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI (optional, feature-flagged)
AI_PROVIDER="mock"
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
AI_MODEL="meta-llama/llama-3.1-8b:free"
AI_FALLBACK_MODELS=""

# Email (optional)
RESEND_API_KEY=""

# App
# Canonical site URL used for auth redirects (Supabase emailRedirectTo).
# In production set to your deployed URL. Keep APP_URL for local dev fallback.
NEXT_PUBLIC_SITE_URL="https://english-learning-platform-rust.vercel.app" # prod
# For Vercel preview you can leave NEXT_PUBLIC_SITE_URL empty — runtime falls back to https://${VERCEL_URL} or window.location.origin
NEXT_PUBLIC_APP_URL="http://localhost:3000" # dev local

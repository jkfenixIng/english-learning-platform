    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@prisma/client": "^6.5.0",
    "@supabase/ssr": "^0.5.2",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-learning-platform.local/schemas/curriculum.prd.json",
  "title": "Curriculum PRD Strict Schema",
  "description": "PRD strict contract for 72 lessons / 72 quizzes (5Q) / 24 evaluations (15Q 4/6/5) with IPA and canonical images",
  "type": "object",
  "properties": {
    "lesson": { "$ref": "#/$defs/Lesson" },
    "quiz": { "$ref": "#/$defs/Quiz" },
    "evaluation": { "$ref": "#/$defs/Evaluation" }
  },
  "$defs": {
    "ImageRef": {
      "title": "ImageRef",
      "description": "Canonical PRD image name [nivel]_[modulo]_[tipo]_[descriptor].png",
      "type": "string",
      "pattern": "^[a-c][12]_m[1-4]_(img|audio|ill)_[a-z0-9_]+\\.png$"
    },
    "VocabWithIPA": {
      "title": "VocabWithIPA",
      "type": "object",
      "required": ["word", "ipa"],
      "properties": {
        "word": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "definitionEs": { "type": "string" },
        "example": { "type": "string" },
        "exampleEs": { "type": "string" },
        "ipa": {
          "type": "string",
          "pattern": "^/.+/$",
          "description": "IPA delimited by slashes e.g. /h\u0259\u02c8lo\u028a/"
        },
        "pos": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Lesson": {
      "title": "Lesson",
      "type": "object",
      "required": [
        "id_leccion",
        "titulo",
        "objetivo",
        "explicacion_gramatical",
        "vocabulario_clave",
        "ilustraciones_asociadas"
      ],
      "properties": {
        "id_leccion": {
          "type": "string",
          "pattern": "^[a-c][12]_m[1-4]_l[1-3]$",
          "description": "Canonical lesson id e.g. a1_m1_l1"
        },
        "titulo": {
          "type": "object",
          "required": ["en", "es"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "es": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "objetivo": { "type": "string", "minLength": 10, "maxLength": 300 },
        "explicacion_gramatical": { "type": "string", "minLength": 20 },
        "vocabulario_clave": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/VocabWithIPA" }
        },
        "ilustraciones_asociadas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/ImageRef" }
        },
        "moduleId": {
          "type": "string",
          "pattern": "^[a-c][12]_m[1-4]$",
          "description": "Alias for unit; derived from id_leccion prefix"
        }
      },
      "additionalProperties": false
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["multiple_choice", "fill_blank", "visual"] },
        "prompt": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "string" },
        "image_ref": { "$ref": "#/$defs/ImageRef" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "visual" } } },
          "then": { "required": ["image_ref"] }
        }
      ],
      "additionalProperties": false
    },
    "Quiz": {
      "title": "Quiz",
      "type": "object",
      "required": ["lessonId", "questions"],
      "properties": {
        "lessonId": { "type": "string", "pattern": "^[a-c][12]_m[1-4]_l[1-3]$" },
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/QuizQuestion" }
        }
      },
      "additionalProperties": false
    },
    "EvaluationQuestion": {
      "title": "EvaluationQuestion",
      "type": "object",
      "required": ["id", "category", "type", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["reading", "grammar_vocab", "listening"] },
        "type": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "answer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Evaluation": {
      "title": "Evaluation",
      "type": "object",
      "required": ["moduleId", "questions"],
      "properties": {
        "moduleId": { "type": "string", "pattern": "^[a-c][12]_m[1-4]$" },
        "questions": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/EvaluationQuestion" }
        }
      },
      "additionalProperties": false
    }
  }
}
